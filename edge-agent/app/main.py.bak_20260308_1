def normalize_banner_ads(raw: Any) -> List[Dict[str, Any]]:
    if not isinstance(raw, list):
        return []

    out: List[Dict[str, Any]] = []
    for item in raw:
        if not isinstance(item, dict):
            continue
        message = str(item.get("message") or "").strip()
        try:
            duration = int(item.get("duration") or 5)
        except Exception:
            duration = 5
        if duration <= 0:
            duration = 5
        try:
            repeat_count_per_day = int(item.get("repeat_count_per_day") or item.get("repeatCountPerDay") or 1)
        except Exception:
            repeat_count_per_day = 1
        if repeat_count_per_day <= 0:
            repeat_count_per_day = 1
        try:
            interval_minutes = float(item.get("interval_minutes") or item.get("intervalMinutes") or (1440.0 / repeat_count_per_day))
        except Exception:
            interval_minutes = 1440.0 / repeat_count_per_day
        target_url = str(item.get("target_url") or item.get("url") or "").strip()
        image_url = str(item.get("image_url") or item.get("imageUrl") or item.get("image") or "").strip()
        if not message and not image_url:
            continue
        start_time = str(item.get("start_time") or item.get("startTime") or "00:00").strip() or "00:00"
        out.append({
            "message": message,
            "duration": duration,
            "image_url": image_url,
            "start_time": start_time,
            "repeat_count_per_day": repeat_count_per_day,
            "interval_minutes": interval_minutes,
            "target_url": target_url,
            "url": target_url,
        })
    return out

def normalize_channel(it: dict) -> Optional[Channel]:
    cid = (
        it.get("channel_id")
        or it.get("channel_number")
        or it.get("id")
    )
    if not cid:
        return None

    kind = str(it.get("kind", "")).lower()
    source = it.get("playback_url") or it.get("source_url")

    # Central often sends youtube_linear with empty source_url and a list of items.
    if (not source) and kind == "youtube_linear":
        items = it.get("items") or []
        if isinstance(items, list) and items:
            u = (items[0] or {}).get("url")
            if u:
                source = u
    if not source and kind != "youtube_linear":
        return None

    return Channel(
        id=str(cid).strip(),
        channel_pk=int(it.get("channel_pk") or it.get("id") or 0) or None,
        channel_number=str(it.get("channel_number") or cid).strip(),
        provider_id=str(it.get("provider_id") or "").strip() or None,
        name=str(it.get("name", cid)).strip(),
        category=(str(it.get("category") or "").strip() or None),
        source_url=str(source or "").strip(),
        playback_url=str(it.get("playback_url") or source or "").strip() or None,
        icon_url=(
            str(
                it.get("icon_url")
                or it.get("icon")
                or it.get("logo")
                or ""
            ).strip()
            or None
        ),
        enabled=bool(int(it.get("is_active", 1))) if str(it.get("is_active", "1")).isdigit() else bool(it.get("is_active", True)),
        schedule=it.get("schedule"),
        schedule_start=(
            str(it.get("schedule_start") or it.get("scheduleStart") or (it.get("schedule") or {}).get("start") or "").strip()
            or None
        ),
        items=it.get("items"),
        now=it.get("now") if isinstance(it.get("now"), dict) else None,
        banner_ads=normalize_banner_ads(it.get("banner_ads") or it.get("bannerAds")),
    )


YOUTUBE_HOST_SNIPPETS = (
    "youtube.com",
    "youtu.be",
    "youtube-nocookie.com",
)


def is_youtube(url: str) -> bool:
    if not url:
        return False
    u = url.lower()
    return any(h in u for h in YOUTUBE_HOST_SNIPPETS)

def should_proxy_youtube(ch: Channel) -> bool:
    return PROXY_YOUTUBE and (ch.kind in ("youtube", "youtube_linear") or is_youtube(ch.source_url))

def get_hls_base(request: Optional[Request] = None) -> str:
    if EDGE_PUBLIC_HOST:
        host = EDGE_PUBLIC_HOST
    elif request and request.url.hostname:
        host = request.url.hostname
    else:
        host = "127.0.0.1"
    return f"http://{host}:{HLS_PORT}".rstrip("/")

def get_hls_url(channel_id: str, request: Optional[Request] = None) -> str:
    base = get_hls_base(request)
    return f"{base}/hls/{EDGE_ID}/{channel_id}/index.m3u8"


def is_self_hls_url(url: str) -> bool:
    raw = str(url or "").strip()
    if not raw:
        return False
    try:
        parsed = urlparse(raw)
    except Exception:
        return False
    if parsed.scheme not in ("http", "https"):
        return False
    if not parsed.path.startswith("/hls/"):
        return False

    host = (parsed.hostname or "").strip().lower()
    allowed_hosts = {"127.0.0.1", "localhost"}
    if EDGE_PUBLIC_HOST:
        allowed_hosts.add(EDGE_PUBLIC_HOST.strip().lower())
    if CENTRAL_BASE_URL:
        central_host = (urlparse(CENTRAL_BASE_URL).hostname or "").strip().lower()
        if central_host:
            allowed_hosts.add(central_host)
    return host in allowed_hosts


def uses_direct_ingest(channel: Channel) -> bool:
    if str(channel.kind or "").lower() != "hls":
        return False
    source = (channel.source_url or "").strip()
    playback = (channel.playback_url or "").strip()
    if not source:
        return True
    return is_self_hls_url(source) or is_self_hls_url(playback)


def direct_ingest_candidates(channel: Channel, request: Optional[Request] = None) -> List[str]:
    candidates: List[str] = []
    seen = set()

    def add(url: Optional[str]) -> None:
        raw = str(url or "").strip()
        if not raw or raw in seen:
            return
        seen.add(raw)
        candidates.append(raw)

    playback = (channel.playback_url or "").strip()
    source = (channel.source_url or "").strip()
    add(playback)
    add(source)

    base = get_hls_base(request)
    stream_id = (channel.id or channel.channel_number or "").strip()
    stream_name = (channel.name or "").strip().strip('/')
    provider = (channel.provider_id or "").strip().strip('/')

    if stream_name and stream_id:
        add(f"{base}/hls/{stream_name}/{stream_id}/index.m3u8")
    if provider and stream_id:
        add(f"{base}/hls/{provider}/{stream_id}/index.m3u8")
    if stream_id:
        add(f"{base}/hls/{stream_id}/index.m3u8")
    if stream_name:
        add(f"{base}/hls/{stream_name}/index.m3u8")

    return candidates


def _is_valid_hls_manifest(url: str) -> bool:
    try:
        r = requests.get(url, timeout=1.5, allow_redirects=True)
    except Exception:
        return False
    if r.status_code >= 400:
        return False
    body = (r.text or "").lstrip()
    return body.startswith('#EXTM3U')


def direct_ingest_url(channel: Channel, request: Optional[Request] = None) -> Optional[str]:
    candidates = direct_ingest_candidates(channel, request)
    for candidate in candidates:
        if _is_valid_hls_manifest(candidate):
            return candidate

    stream_id = (channel.id or channel.channel_number or "").strip()
    stream_name = (channel.name or "").strip().strip('/')
    playback = (channel.playback_url or "").strip()
    parsed = None
    try:
        parsed = urlparse(playback) if playback else None
    except Exception:
        parsed = None

    if parsed and parsed.path.startswith('/hls/') and stream_name and stream_id:
        return f"{get_hls_base(request)}/hls/{stream_name}/{stream_id}/index.m3u8"
    return candidates[0] if candidates else None

def resolve_youtube(url: str) -> str:
    cmd = ["yt-dlp", "-f", YTDLP_FORMAT, "-g", url]
    out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True, timeout=30)
    line = out.strip().splitlines()[0].strip()
    if not line:
        raise RuntimeError("yt-dlp returned empty URL")
    return line


def _to_int(v: Any, default: int = 0) -> int:
    try:
        return int(v)
    except Exception:
        return int(default)


def is_trackable_live_item(item: Dict[str, Any]) -> bool:
    if not isinstance(item, dict):
        return False
    if str(item.get("type") or "").strip().lower() != "video":
        return False
    if _to_int(item.get("is_live"), 0) != 1:
        return False
    if _to_int(item.get("auto_remove_on_end"), 0) != 1:
        return False
    return bool(str(item.get("url") or "").strip())


def youtube_item_is_live(url: str) -> Optional[bool]:
    if not url or not is_youtube(url):
        return None
    if not YTDLP_AVAILABLE:
        return None
    cmd = [
        YTDLP_BIN,
        "--no-warnings",
        "--skip-download",
        "--dump-single-json",
        url,
    ]
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True, timeout=20)
        info = json.loads(out.strip() or "{}")
    except Exception:
        return None

    status = str(info.get("live_status") or "").strip().lower()
    return bool(info.get("is_live")) or status == "is_live"


def generic_live_url_is_reachable(url: str) -> Optional[bool]:
    if not url:
        return None
    try:
        r = requests.get(url, timeout=5, allow_redirects=True)
        if r.status_code >= 400:
            return False
        body = (r.text or "").strip()
        if not body:
            return False
        return True
    except Exception:
        return False


def notify_central_live_ended(channel: Channel, item: Dict[str, Any], reason: str = "edge_probe_ended") -> bool:
    if not CENTRAL_BASE_URL or not API_KEY or not channel.channel_pk:
        return False
    url = str(item.get("url") or "").strip()
    if not url:
        return False
    payload = {
        "event": "live_ended",
        "action": "ended",
        "channel_pk": int(channel.channel_pk),
        "item_id": _to_int(item.get("id"), 0) or None,
        "url": url,
        "source": str(item.get("live_source") or "edge").strip() or "edge",
        "reason": reason,
    }
    headers = {
        "X-API-KEY": API_KEY,
        "X-EDGE-ID": EDGE_ID,
    }
    try:
        r = requests.post(CENTRAL_LIVE_EVENTS_URL, headers=headers, json=payload, timeout=8)
        return 200 <= r.status_code < 300
    except Exception:
        return False


def probe_live_items_once() -> None:
    if not last_channels:
        return
    now = time.time()
    # expire cache keys periodically
    for k, ts in list(_dead_live_notified.items()):
        if (now - ts) > 600:
            _dead_live_notified.pop(k, None)

    for ch in list(last_channels.values()):
        if str(ch.kind or "").lower() != "youtube_linear":
            continue
        if not isinstance(ch.items, list) or not ch.items:
            continue

        for item in ch.items:
            if not is_trackable_live_item(item):
                continue
            item_url = str(item.get("url") or "").strip()
            key = f"{ch.id}:{item.get('id')}:{item_url}"
            if key in _dead_live_notified:
                continue
            if is_youtube(item_url):
                live_state = youtube_item_is_live(item_url)
            else:
                live_state = generic_live_url_is_reachable(item_url)
            if live_state is None:
                continue
            if live_state:
                continue
            if notify_central_live_ended(ch, item):
                _dead_live_notified[key] = now

def build_ffmpeg_cmd(channel_id: str, source_url: str):
    # Namespaced publish path so the generated HLS directory becomes:
    # /hls/{EDGE_ID}/{channel_id}/index.m3u8
    publish_url = f"{RTMP_PUBLISH_BASE}/{EDGE_ID}/{channel_id}"

    headers = (
        "User-Agent: Mozilla/5.0\r\n"
        "Referer: https://google.com\r\n"
        "Origin: https://google.com\r\n"
        "Accept: */*\r\n"
    )

    return [
        "ffmpeg",
        "-hide_banner",
        "-loglevel", "info",

        "-reconnect", "1",
        "-reconnect_streamed", "1",
        "-reconnect_delay_max", "10",

        "-headers", headers,

        "-i", source_url,

        "-map", "0:v:0",
        "-map", "0:a:0?",

        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-profile:v", "baseline",
        "-preset", "veryfast",
        "-g", "60",
        "-keyint_min", "60",
        "-sc_threshold", "0",
        "-bf", "0",

        "-c:a", "aac",
        "-ar", "44100",
        "-ac", "2",

        "-f", "flv",
        publish_url
    ]

def stop_channel(channel_id: str):
    p = procs.get(channel_id)
    if p and p.poll() is None:
        try:
            p.terminate()
            p.wait(timeout=5)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
    procs.pop(channel_id, None)

def start_channel(channel: Channel):
    # Requirement: YouTube should be executed directly (bypass), not transcoded to HLS.
    if channel.kind in ("youtube", "youtube_linear") or is_youtube(channel.source_url):
        return
    if uses_direct_ingest(channel):
        stop_channel(channel.id)
        print(f"[EDGE] Skipping local transcode for direct-ingest channel {channel.id}: {direct_ingest_url(channel) or '-'}")
        return
    if channel.id in procs and procs[channel.id].poll() is None:
        return
    source_url = channel.source_url
    if should_proxy_youtube(channel) and is_youtube(source_url):
        if source_url in resolved_cache:
            source_url = resolved_cache[source_url]
        else:
            source_url = resolve_youtube(source_url)
            resolved_cache[channel.source_url] = source_url

    cmd = build_ffmpeg_cmd(channel.id, source_url)

    print(f"[EDGE] Starting channel {channel.id}")
    print(" ".join(cmd))

    p = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    procs[channel.id] = p

    def log_errors():
        try:
            for line in p.stderr:
                print(f"[FFMPEG:{channel.id}] {line.strip()}")
        except:
            pass

    threading.Thread(target=log_errors, daemon=True).start()

def parse_central_payload(payload: dict) -> Dict[str, Channel]:
    channels: Dict[str, Channel] = {}

    providers = payload.get("providers", []) or []
    for prov in providers:
        for it in (prov.get("channels", []) or []):
            ch = normalize_channel(it)
            if not ch:
                continue

            # define kind de forma compatível
            ch.kind = (
                str(it.get("kind")).lower()
                if it.get("kind")
                else ("youtube" if is_youtube(ch.source_url) else "hls")
            )

            # preserva playback_url se vier da Central
            ch.playback_url = it.get("playback_url") or ch.source_url
            ch.schedule = it.get("schedule")
            ch.items = it.get("items")
            ch.schedule_start = (
                str(it.get("schedule_start") or it.get("scheduleStart") or (it.get("schedule") or {}).get("start") or "").strip()
                or ch.schedule_start
            )
            ch.channel_number = str(it.get("channel_number") or ch.channel_number or ch.id).strip()
            ch.provider_id = str(it.get("provider_id") or ch.provider_id or "").strip() or ch.provider_id
            ch.now = it.get("now") if isinstance(it.get("now"), dict) else None

            channels[ch.id] = ch

    return channels


def sync_once():
    global last_sync_ts, last_error, last_channels
    headers = {
        "X-API-KEY": API_KEY,
        "X-EDGE-ID": EDGE_ID,
    }

    try:
        r = requests.get(CENTRAL_CHANNELS_URL, headers=headers, timeout=10)
        r.raise_for_status()
        data = r.json()

        channels = parse_central_payload(data)

        # stop removed
        for cid in list(last_channels.keys()):
            if cid not in channels or not channels[cid].enabled:
                stop_channel(cid)

        # start/update
        for cid, ch in channels.items():
            if not ch.enabled:
                stop_channel(cid)
                continue
            prev = last_channels.get(cid)
            if prev and (prev.source_url != ch.source_url or prev.kind != ch.kind):
                stop_channel(cid)
            if ch.kind == "youtube_linear" and not should_proxy_youtube(ch):
                continue
            start_channel(ch)

        last_channels = channels
        last_error = None
        last_sync_ts = time.time()

    except Exception as e:
        last_error = str(e)

def is_live_playlist_item(item: Any) -> bool:
    if not isinstance(item, dict):
        return False
    return str(item.get("is_live") or "0").strip().lower() in ("1", "true", "yes", "on")


def _first_item_url(items: Any, include_live: bool = True) -> Optional[str]:
    if not isinstance(items, list) or not items:
        return None
    for raw_item in items:
        if not isinstance(raw_item, dict):
            continue
        if str(raw_item.get("type") or "video").strip().lower() != "video":
            continue
        if not include_live and is_live_playlist_item(raw_item):
            continue
        u = str(raw_item.get("url") or "").strip()
        if u:
            return u
    return None

def youtube_bypass_url(ch: Channel, include_live: bool = True) -> Optional[str]:
    if not include_live and str(ch.kind or "").lower() == "youtube_linear":
        return _first_item_url(ch.items, include_live=False)
    u = (ch.source_url or "").strip() or (ch.playback_url or "").strip()
    if u:
        return u
    return _first_item_url(ch.items, include_live=include_live)


def app_channel_id(ch: Channel) -> str:
    return str(ch.channel_number or ch.id).strip()


def normalize_duration(raw: Any, fallback: int) -> int:
    try:
        value = int(raw)
    except Exception:
        value = fallback
    if value <= 0:
        value = fallback
    return value


def central_now_url(ch: Channel) -> Optional[str]:
    if not isinstance(ch.now, dict):
        return None
    val = str(ch.now.get("url") or "").strip()
    return val or None

def to_app_item(ch: Channel, request: Request) -> Optional[dict]:
    """Return an item in the exact shape expected by lineartv-pro App.tsx."""
    # For HLS/live: keep offset at 0 by using a far-future schedule_start.
    schedule_start = ch.schedule_start or ("2099-01-01T00:00:00Z" if ch.kind == "hls" else "2024-01-01T00:00:00Z")
    now_url = central_now_url(ch)

    if ch.kind == "youtube_linear":
        # If central resolves a current item (live override), publish it directly.
        if now_url:
            now_duration = normalize_duration((ch.now or {}).get("duration"), 3600)
            return {
                "channel_id": app_channel_id(ch),
                "name": ch.name,
                "category": ch.category or "",
                "kind": "youtube",
                "schedule_start": schedule_start,
                "items": [{"type": "video", "url": now_url, "duration": now_duration}],
                "banner_ads": ch.banner_ads or [],
                "icon_url": ch.icon_url or "",
                "icon": ch.icon_url or "",
                "logo": ch.icon_url or "",
                "loop": True,
            }

        items = ch.items if isinstance(ch.items, list) else []
        # Ensure items list is in the expected schema
        norm_items = []
        for it in items:
            if not isinstance(it, dict):
                continue
            if str(it.get("type") or "video").strip().lower() != "video":
                continue
            if is_live_playlist_item(it):
                continue
            u = str(it.get("url") or "").strip()
            if not u:
                continue
            d = normalize_duration(it.get("duration"), 60)
            norm_items.append({"type": "video", "url": u, "duration": d})
        if not norm_items:
            u = youtube_bypass_url(ch, include_live=False)
            if not u:
                return None
            norm_items = [{"type": "video", "url": u, "duration": 3600}]
        return {
            "channel_id": app_channel_id(ch),
            "name": ch.name,
            "category": ch.category or "",
            "kind": "youtube_linear",
            "schedule_start": schedule_start,
            "items": norm_items,
            "banner_ads": ch.banner_ads or [],
            "icon_url": ch.icon_url or "",
            "icon": ch.icon_url or "",
            "logo": ch.icon_url or "",
            "loop": True,
        }

    if ch.kind == "youtube" or is_youtube(ch.source_url) or is_youtube(ch.playback_url or ""):
        u = now_url or youtube_bypass_url(ch)
        if not u:
            return None
        return {
            "channel_id": app_channel_id(ch),
            "name": ch.name,
            "category": ch.category or "",
            "kind": "youtube",
            "schedule_start": schedule_start,
            "items": [{"type": "video", "url": u, "duration": 3600}],
            "banner_ads": ch.banner_ads or [],
            "icon_url": ch.icon_url or "",
            "icon": ch.icon_url or "",
            "logo": ch.icon_url or "",
            "loop": True,
        }

    # Default: HLS served by this edge
    hls_url = direct_ingest_url(ch, request) if uses_direct_ingest(ch) else get_hls_url(ch.id, request)
    if not hls_url:
        return None
    return {
        "channel_id": app_channel_id(ch),
        "name": ch.name,
        "category": ch.category or "",
        "kind": "hls",
        "schedule_start": schedule_start,
        "items": [{"type": "video", "url": hls_url, "duration": 86400}],
        "banner_ads": ch.banner_ads or [],
        "icon_url": ch.icon_url or "",
        "icon": ch.icon_url or "",
        "logo": ch.icon_url or "",
        "loop": True,
    }


def worker_loop():
    global _last_live_event_check_ts
    while True:
        sync_once()
        now = time.time()
        if (now - _last_live_event_check_ts) >= LIVE_EVENT_CHECK_INTERVAL:
            try:
                probe_live_items_once()
            except Exception:
                pass
            _last_live_event_check_ts = now

        # reiniciar processos que morreram
        for cid, ch in list(last_channels.items()):
            if not ch.enabled:
                continue
            if ch.kind == "youtube_linear" or uses_direct_ingest(ch):
                continue
            p = procs.get(cid)
            if p is None or p.poll() is not None:
                stop_channel(cid)
                try:
                    start_channel(ch)
                except Exception:
                    pass

        time.sleep(max(5, SYNC_INTERVAL))

@app.on_event("startup")
def on_startup():
    t = threading.Thread(target=worker_loop, daemon=True)
    t.start()

